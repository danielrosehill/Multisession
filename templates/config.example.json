{
  "default_space": "local",
  "local_space": "~/a2a-workspace",
  "drive": {
    "folder_id": "<Google Drive folder ID for remote agent exchange>",
    "folder_url": "https://drive.google.com/drive/folders/<id>",
    "account": "<google account the Drive tools act as>",
    "max_file_mb": 10
  },
  "close_delay_s": 6,
  "receipt_timeout_s": 300,
  "presets": {},
  "notify": {
    "call_enabled": false,
    "user_name": "<first name>",
    "user_phone": "<E.164>",
    "vapi": {
      "assistant_id": "<id>",
      "phone_number_id": "<id>"
    },
    "contacts": []
  },
  "remote": {
    "hosts": {
      "<alias>": {
        "ssh": "<ssh alias or user@host>",
        "exec_tool": "<optional>"
      }
    }
  },
  "vocabulary": {
    "_doc": "Optional. Your own words for where a new session goes; wins over the skills' built-in table. Add a phrase whenever Claude gets it wrong.",
    "default": {
      "layout": "split",
      "direction": "right"
    },
    "phrases": [
      {
        "says": [
          "split",
          "horizontal split",
          "beside"
        ],
        "layout": "split",
        "direction": "right"
      },
      {
        "says": [
          "vertical split",
          "below"
        ],
        "layout": "split",
        "direction": "down"
      },
      {
        "says": [
          "new tab"
        ],
        "layout": "tab"
      },
      {
        "says": [
          "new window"
        ],
        "layout": "window"
      }
    ]
  }
}
